{
  "name": "@zwf/web-lms-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unit- та інтеграційні тести SPA-кабінету (apps/web-lms): Vitest + Testing Library + jsdom.",
